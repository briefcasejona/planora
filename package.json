{
  "name": "planora",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "cap:sync": "npm run build && cap sync",
    "android": "cap open android",
    "icons": "node scripts/icons.mjs",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "e2e:desktop": "npm run build && playwright test -c playwright.desktop.config.ts",
    "dist:mac": "npm run build && electron-builder --mac --publish never -c.electronDist=",
    "dist:linux": "npm run build && electron-builder --linux --publish never -c.electronDist="
  },
  "dependencies": {
    "@azure/msal-browser": "^5.25.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "i18next": "^26.4.2",
    "ical.js": "^2.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "sharp": false,
    "electron-winstaller": false,
    "electron@44.7.0": true
  },
  "description": "Privacy-first planning app for students and teachers",
  "author": "Jonathan",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.planora",
    "productName": "Planora",
    "files": [
      "dist/**",
      "electron/**",
      "csp.cjs",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Planora",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Planora-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Planora-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Planora-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "Planora-${version}.AppImage"
    },
    "fileAssociations": [
      {
        "ext": "ics",
        "name": "iCalendar",
        "description": "Calendar file",
        "role": "Viewer"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "dmg": {
      "title": "Planora",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
