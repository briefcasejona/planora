# Optional: Microsoft Entra ID (Azure) application (client) ID for Outlook/Teams/To Do integration.
# Leave empty to keep the Microsoft integration disabled. See README.md.
VITE_MS_CLIENT_ID=
# Optional: tenant. "common" = work/school + personal accounts, "organizations" = school/work only.
VITE_MS_TENANT=common
# Optional: Google OAuth client ID (Web application type) for Google Calendar free/busy.
VITE_GOOGLE_CLIENT_ID=
